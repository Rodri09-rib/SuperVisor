# ==========================================
# SuperVisor - variaveis de ambiente (MODELO)
# Copie para .env e preencha. NUNCA versione o .env.
# ==========================================
#
# Gere o segredo JWT com pelo menos 32 bytes aleatorios:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:       openssl rand -base64 48
#
# Carregue as variaveis antes de arrancar a aplicacao:
#   PowerShell: Get-Content .env | Where-Object { $_ -match '\S' -and $_ -notmatch '^#' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item -Path "env:$k" -Value $v }
#   bash:       set -a; . ./.env; set +a
#
# Os testes NAO usam estes valores: PostgresTestContainer sobrescreve a
# configuracao do datasource e do segredo JWT.

# Obrigatorio: segredo de assinatura do JWT (sem valor por omissao)
JWT_SECRET=

# Base de dados lida por src/main/resources/application.yml
DB_URL=jdbc:postgresql://localhost:5432/supervisor
DB_USERNAME=supervisor
DB_PASSWORD=

# PostgreSQL local do docker-compose.yml
DB_NAME=supervisor
DB_PORT=5432
