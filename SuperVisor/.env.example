# ==========================================
# Segredos de ambiente - MODELO. Nao contem valores reais.
# Copie para `.env` (que esta no .gitignore) e preencha com os valores locais.
# ==========================================
#
# A aplicacao le o segredo de assinatura do JWT da variavel de ambiente
# JWT_SECRET, exigida por src/main/resources/application.yml. Nao existe valor
# por omissao: se a variavel faltar, a aplicacao falha ao arrancar de
# proposito, para nunca assinar tokens com uma chave previsivel.
#
# Gere um valor com pelo menos 32 bytes aleatorios, por exemplo:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:       openssl rand -base64 48
#
# Para carregar as variaveis antes de correr a aplicacao:
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '\S' -and $_ -notmatch '^#' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item -Path "env:$k" -Value $v }
#   bash:        set -a; . ./.env; set +a
#
# Os testes NAO dependem deste valor: sobrescrevem a propriedade em
# src/test/java/tests/support/PostgresTestContainer.java

# Segredo de assinatura do JWT (OBRIGATORIO - a aplicacao nao arranca sem isto)
JWT_SECRET=
