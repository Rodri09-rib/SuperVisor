# ==========================================
# Segredos de ambiente - MODELO. Não contém valores reais.
# Copie para `.env` (que está no .gitignore) e preencha com os valores locais.
# ==========================================
#
# A aplicação lê o segredo de assinatura do JWT da variável de ambiente
# JWT_SECRET, exigida por src/main/resources/application.yml. Não existe valor
# por omissão: se a variável faltar, a aplicação falha ao arrancar de
# propósito, para nunca assinar tokens com uma chave previsível.
#
# Gere um valor com pelo menos 32 bytes aleatorios, por exemplo:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:       openssl rand -base64 48
#
# Para carregar as variáveis antes de correr a aplicação:
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '\S' -and $_ -notmatch '^#' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item -Path "env:$k" -Value $v }
#   bash:        set -a; . ./.env; set +a
#
# Os testes NÃO dependem deste valor: sobrescrevem a propriedade em
# src/test/java/tests/support/PostgresTestContainer.java

# Segredo de assinatura do JWT (OBRIGATÓRIO - a aplicação não arranca sem isto)
JWT_SECRET=
